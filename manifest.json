{
  "manifest_version": 3,
  "name": "Local LanguageTool",
  "version": "1.0.0",
  "description": "Inline spelling and grammar checking through your local LanguageTool server.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8081/*", "http://localhost:8081/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "css": ["content/styles.css"],
    "js": ["content/boot.js"],
    "all_frames": true,
    "match_origin_as_fallback": true,
    "run_at": "document_end"
  }],
  "web_accessible_resources": [{
    "resources": ["content/*.js"],
    "matches": ["<all_urls>"]
  }],
  "action": {
    "default_title": "Local LanguageTool",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "local-languagetool@local",
      "strict_min_version": "128.0"
    }
  }
}
